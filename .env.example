# Copia este archivo como .env.local y completa los valores.

# Compra del libro
# Ficha de Doble Agente en Amazon (ebook e impreso). Si se deja vacía, el botón lleva a la búsqueda del título en Amazon.
NEXT_PUBLIC_AMAZON_URL=
# Enlace de pago de Mercado Pago para el libro en PDF (tarjeta de crédito, débito o saldo en cuenta).
# Si se deja vacía, el botón «Pagar con Mercado Pago» abre WhatsApp (+51 989 338 401) con un mensaje prellenado pidiendo el PDF.
NEXT_PUBLIC_CHECKOUT_URL=

# Página de citas de Google Calendar para «Agenda 30 minutos» (también la usa /agenda, el QR del cierre del libro).
# Si se deja vacía, los enlaces «Agenda 30 minutos» y /agenda abren WhatsApp.
NEXT_PUBLIC_AGENDA_URL=

# Registro de los formularios: Google Apps Script ligado a la hoja de registros (ver apps-script/README.md).
# Solo del servidor: nunca con el prefijo NEXT_PUBLIC. Sin ellas, los formularios ofrecen WhatsApp y los de descarga entregan el PDF igual.
# URL de la aplicación web publicada (termina en /exec).
APPS_SCRIPT_URL=
# El mismo valor que la propiedad SECRET del script (configurar() la crea y la muestra en el registro).
APPS_SCRIPT_SECRET=
