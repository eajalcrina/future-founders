# Copia este archivo como .env.local y completa los valores.

# Compra del libro
# Ficha de Doble Agente en Amazon (ebook e impreso). Si se deja vacía, el botón lleva a la búsqueda del título en Amazon.
NEXT_PUBLIC_AMAZON_URL=
# Enlace de pago de la compra directa (PDF + workbook). Si se deja vacía, el botón abre WhatsApp (+51 989 338 401)
# con un mensaje prellenado pidiendo el PDF con el workbook.
NEXT_PUBLIC_CHECKOUT_URL=

# Agenda de 30 minutos (Calendly u otra). Si se deja vacía, los enlaces «Agenda 30 minutos» abren WhatsApp.
NEXT_PUBLIC_AGENDA_URL=

# Brevo: lista de correo de los formularios (kit, diagnóstico, programas, llamada final). Lista id 2.
BREVO_API_KEY=

# Supabase: registro de leads (tabla quiz_leads) y datos del toolkit.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
